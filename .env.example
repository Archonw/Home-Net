# Adresse der FritzBox
FRITZ_ADDRESS=192.168.178.1
# FritzBox-Benutzer mit Rechten "FRITZ!Box Einstellungen" (eigenen Benutzer anlegen!)
FRITZ_USER=networkmonitor
FRITZ_PASSWORD=
# Passwort für die Weboberfläche (Benutzer: admin). Leer = keine Anmeldung (nicht empfohlen)
UI_PASSWORD=
# Abfrageintervall in Sekunden
POLL_INTERVAL=30
# Geräte aus dem allerersten Scan automatisch als "erlaubt" markieren
TRUST_INITIAL_DEVICES=true
# Unbekannte Geräte sofort vom Internet trennen, bis sie erlaubt werden
QUARANTINE_UNKNOWN=false

# Benachrichtigung bei neuen Geräten: telegram, homeassistant oder beides (telegram,homeassistant)
NOTIFY=
# Adresse der Weboberfläche, wird in Benachrichtigungen verlinkt
PUBLIC_URL=http://192.168.178.207:8085/

# Telegram: Bot bei @BotFather anlegen, Token hier eintragen, dem Bot eine Nachricht schicken,
# dann die Chat-ID über https://api.telegram.org/bot<TOKEN>/getUpdates ablesen ("chat":{"id":...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Home Assistant: Profil → Sicherheit → Langlebiges Zugriffstoken erstellen
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Name des notify-Dienstes der Companion-App, z. B. mobile_app_jans_handy
HA_NOTIFY_SERVICE=
