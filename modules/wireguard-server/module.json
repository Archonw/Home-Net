{
  "id": "wireguard-server",
  "name": "WireGuard (Server)",
  "description": "Installiert WireGuard-Easy selbst: VPN ins Heimnetz (nur nötig, wenn noch keins läuft)",
  "icon": "assets/icons/wireguard.png",
  "api": {"external_port": 51821},
  "services": {
    "wireguard-server": {
      "image": "ghcr.io/wg-easy/wg-easy:15",
      "ports": ["51820:51820/udp", "51821:51821/tcp"],
      "environment": [
        "TZ=${TZ}",
        "PORT=51821",
        "INSECURE=true",
        "DISABLE_IPV6=true"
      ],
      "env_file": ["${DATA_DIR}/wireguard-server.env"],
      "volumes": [
        "${WG_EASY_DATA}:/etc/wireguard",
        "/lib/modules:/lib/modules:ro"
      ],
      "cap_add": ["NET_ADMIN", "SYS_MODULE"],
      "sysctls": [
        "net.ipv4.ip_forward=1",
        "net.ipv4.conf.all.src_valid_mark=1"
      ]
    }
  }
}
