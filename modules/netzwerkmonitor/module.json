{
  "id": "netzwerkmonitor",
  "name": "Netzwerk",
  "description": "Überwacht die Geräte im Netz, meldet neue und lässt sie erlauben oder sperren",
  "icon": "assets/icons/netzwerk.png",
  "api": {
    "socket": "/run/netzwerkmonitor/api.sock",
    "health": "/health",
    "public": [
      "/app",
      "/assets",
      "/health"
    ],
    "web": true
  },
  "services": {
    "networkmonitor": {
      "build": "modules/netzwerkmonitor",
      "network_mode": "host",
      "cap_add": [
        "NET_RAW",
        "NET_ADMIN"
      ],
      "volumes": [
        "${DATA_DIR}/netzwerkmonitor:/data",
        "${DATA_DIR}/netzwerkmonitor/run:/run/netzwerkmonitor",
        "${DATA_DIR}/events/netzwerkmonitor:/run/home-net-events"
      ],
      "env_file": [
        "${DATA_DIR}/netzwerkmonitor.env"
      ],
      "environment": [
        "LISTEN_SOCKET=/run/netzwerkmonitor/api.sock",
        "EVENTS_DIR=/run/home-net-events"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import socket;s=socket.socket(socket.AF_UNIX);s.connect('/run/netzwerkmonitor/api.sock');s.send(b'GET /health HTTP/1.0\\r\\n\\r\\n');assert b' 200 ' in s.recv(64)"
        ]
      }
    }
  },
  "events": [
    {
      "id": "new_device",
      "label": "Neues Gerät im Netz"
    },
    {
      "id": "device_offline",
      "label": "Gerät im Blick offline oder wieder da"
    },
    {
      "id": "router_down",
      "label": "FritzBox nicht erreichbar oder wieder da"
    }
  ]
}
