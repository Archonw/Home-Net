{
  "id": "netzwerkmonitor",
  "name": "Netzwerk",
  "description": "Überwacht die Geräte im Netz, meldet neue und lässt sie erlauben oder sperren",
  "icon": "assets/icons/netzwerk.png",
  "api": {"port": 8085, "health": "/health"},
  "services": {
    "networkmonitor": {
      "build": "modules/netzwerkmonitor",
      "network_mode": "host",
      "cap_add": ["NET_RAW", "NET_ADMIN"],
      "volumes": ["${DATA_DIR}/netzwerkmonitor:/data"]
    }
  }
}
