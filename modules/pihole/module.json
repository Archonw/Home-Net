{
  "id": "pihole",
  "name": "Pi-hole",
  "description": "Werbefilter aller Pi-holes kurz pausieren und Statistiken ansehen",
  "icon": "assets/icons/pihole.png",
  "api": {
    "socket": "/run/pihole/api.sock",
    "health": "/health",
    "public": [
      "/health"
    ],
    "web": true
  },
  "services": {
    "pihole-verwaltung": {
      "build": "modules/pihole",
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "environment": [
        "TZ=${TZ}",
        "DATA=/data",
        "LISTEN_SOCKET=/run/pihole/api.sock",
        "EVENTS_DIR=/run/home-net-events"
      ],
      "volumes": [
        "${DATA_DIR}/pihole/config:/data",
        "${DATA_DIR}/pihole/run:/run/pihole",
        "${DATA_DIR}/events/pihole:/run/home-net-events"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python3",
          "-c",
          "import socket;s=socket.socket(socket.AF_UNIX);s.connect('/run/pihole/api.sock');s.send(b'GET /health HTTP/1.0\\r\\n\\r\\n');assert b' 200 ' in s.recv(64)"
        ]
      }
    }
  },
  "events": [
    {
      "id": "pihole_offline",
      "label": "Ein Pi-hole ist nicht erreichbar"
    },
    {
      "id": "pihole_online",
      "label": "Ein Pi-hole ist wieder erreichbar"
    },
    {
      "id": "pihole_update",
      "label": "Update für Pi-hole verfügbar",
      "manager_only": true
    },
    {
      "id": "pihole_updated",
      "label": "Pi-hole wurde aktualisiert",
      "manager_only": true
    },
    {
      "id": "pihole_update_failed",
      "label": "Update eines Pi-hole fehlgeschlagen",
      "manager_only": true
    }
  ]
}
